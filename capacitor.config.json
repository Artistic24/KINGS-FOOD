{
  "appId": "com.kingsfood.app",
  "appName": "KINGS FOOD",
  "webDir": "android-shell",
  "server": {
    "url": "https://kings-marketplace.lovable.app",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "error.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "Geolocation": {},
    "Camera": {},
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
